<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="HAND_Overclocked_Soundbank.bnk" />
    <None Remove="HenryBank.bnk" />
    <None Remove="Modules\Characters\Henry.cs~RF6221a098.TMP" />
    <None Remove="rmorassetbundle" />
  </ItemGroup>

	<ItemGroup>
		<PackageReference Include="BepInEx.Analyzers" Version="1.0.*">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="BepInEx.Core" Version="5.*" />
		<PackageReference Include="RiskOfRain2.GameLibs" Version="1.4.1-r.0" />
		<PackageReference Include="UnityEngine.Modules" Version="2021.3.33" />
		<PackageReference Include="MMHOOK.RoR2" Version="2025.11.19">
			<NoWarn>NU1701</NoWarn>
		</PackageReference>
		<PackageReference Include="R2API.Core" Version="5.*" />
		<PackageReference Include="R2API.Prefab" Version="1.*" />
		<PackageReference Include="R2API.RecalculateStats" Version="1.*" />
		<PackageReference Include="R2API.Sound" Version="1.*" />
		<PackageReference Include="R2API.DamageType" Version="1.*" />
		<PackageReference Include="R2API.Language" Version="1.*" />
	</ItemGroup>
	
  <ItemGroup>
    <EmbeddedResource Include="HAND_Overclocked_Soundbank.bnk" />
    <EmbeddedResource Include="rmorassetbundle" />
  </ItemGroup>

  <ItemGroup>
    <!-- UNet networking — not included in RiskOfRain2.GameLibs -->
    <Reference Include="com.unity.multiplayer-hlapi.Runtime">
      <HintPath>libs\com.unity.multiplayer-hlapi.Runtime.dll</HintPath>
    </Reference>
    <!-- Post-processing visual effects -->
    <Reference Include="Unity.Postprocessing.Runtime">
      <HintPath>libs\Unity.Postprocessing.Runtime.dll</HintPath>
    </Reference>
    <!-- Soft dependencies -->
    <Reference Include="CustomEmotesAPI">
      <HintPath>libs\SoftDependencies\CustomEmotesAPI.dll</HintPath>
    </Reference>
    <Reference Include="RiskOfOptions">
      <HintPath>libs\SoftDependencies\RiskOfOptions.dll</HintPath>
    </Reference>
    <Reference Include="AncientScepter">
      <HintPath>libs\SoftDependencies\AncientScepter.dll</HintPath>
    </Reference>
    <Reference Include="ClassicItems">
      <HintPath>libs\SoftDependencies\ClassicItems.dll</HintPath>
    </Reference>
    <!--<Reference Include="TILER2">
      <HintPath>libs\SoftDependencies\TILER2.dll</HintPath>
    </Reference>-->
    <Reference Include="KingKombatArena">
      <HintPath>libs\SoftDependencies\KingKombatArena.dll</HintPath>
    </Reference>
  </ItemGroup>

  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <Exec Command="if exist &quot;$(ProjectDir)..\HAND_Unity\AssetBundles\StandaloneWindows\rmorassetbundle&quot; copy /Y &quot;$(ProjectDir)..\HAND_Unity\AssetBundles\StandaloneWindows\rmorassetbundle&quot; &quot;$(ProjectDir)&quot;" />
  </Target>

</Project>

